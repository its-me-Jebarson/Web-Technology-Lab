</head>
<body>
    <h1>BMI Calculator - URK24CS1159</h1>
    <input id="w" type="number" placeholder="Weight (kg)">
    <br>
    <input id="h" type="number" placeholder="Height (m)">
    <br>
    <button onclick="bmi()">Calculate</button>
    <p id="result"></p>
    <script>
        function bmi() {
            let b = w.value / (h.value * h.value);
            result.innerHTML = "BMI: " + b.toFixed(2);
        }
