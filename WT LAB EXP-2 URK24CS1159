<!DOCTYPE html>
<html>
<head>
<title>HTML5 Form and Media Elements</title>
<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
}
body{
font-family:Arial,sans-serif;
background:#EAF4FF;
}
.container{
width:1100px;
margin:20px auto;
background:white;
border-radius:10px;
overflow:hidden;
box-shadow:0 0 10px gray;
}
.header{
background:#1565C0;
color:white;
display:flex;
align-items:center;
padding:20px;
}
.header img{
width:160px;
height:160px;
border-radius:50%;
border:4px solid white;
}
.header h1{
flex:1;
text-align:center;
font-size:40px;
}
nav{
background:#BBDEFB;
display:flex;
align-items:center;
padding:15px;
}
nav a{
text-decoration:none;
color:#0D47A1;
font-weight:bold;
margin-right:70px;
}
nav input{
margin-left:auto;
width:250px;
padding:8px;
border-radius:5px;
border:1px solid #1565C0;
}
.top{
display:flex;
justify-content:space-between;
padding:20px;
background:#F5FAFF;
}
.skills{
width:30%;
}
.skills h2{
color:#1565C0;
margin-bottom:15px;
}
.skills p{
margin-top:15px;
font-weight:bold;
}
progress{
width:230px;
height:20px;
}
.video{
width:65%;
text-align:center;
}
.video h2{
color:#1565C0;
margin-bottom:15px;
}
video{
width:600px;
height:320px;
border:3px solid #1565C0;
border-radius:8px;
}
audio{
width:500px;
margin-top:20px;
}
.form-container{
display:flex;
justify-content:space-between;
padding:20px;
background:#F8FCFF;
}
fieldset{
width:48%;
padding:15px;
border:2px solid #1565C0;
border-radius:8px;
}
legend{
font-size:22px;
font-weight:bold;
color:#1565C0;
}
input,
textarea,
select{
width:100%;
padding:8px;
margin:6px 0;
}
input[type=radio],
input[type=checkbox]{
width:auto;
}
.bottom{
display:flex;
justify-content:space-between;
padding:20px;
background:#F5FAFF;
}
footer{
background:#1565C0;
color:white;
text-align:center;
padding:15px;
}
</style>
</head>
<body>
<div class="container">
<div class="header">
