<form>
<div class="form-container">
<!-- Personal Information -->
<fieldset>
<legend>Personal Information</legend>
<label>Full Name</label>
<input type="text" placeholder="Enter Full Name">
<label>User Name</label>
<input type="text" placeholder="Enter User Name">
<label>Password</label>
<input type="password" placeholder="Enter Password">
<label>Register Number</label>
<input type="text" placeholder="URK24CSXXXX">
<label>Age</label>
<input type="number">
<label>Gender</label><br>
<input type="radio" name="gender"> Male
<input type="radio" name="gender"> Female
<br><br>
<label>Date of Birth</label>
<input type="date">
<label>Favourite Color</label>
<input type="color">
<br><br>
<label>Upload Photo</label>
<input type="file">
</fieldset>
<!-- Contact Information -->
<fieldset>
<legend>Contact Information</legend>
<label>Address</label>
<textarea rows="3"></textarea>
<label>State</label>
<select>
<option>Select State</option>
<option>Tamil Nadu</option>
<option>Kerala</option>
<option>Karnataka</option>
<option>Andhra Pradesh</option>
</select>
<label>Zip Code</label>
<input type="number">
<label>Mobile Number</label>
<input type="tel" placeholder="9876543210">
<label>Email</label>
<input type="email" placeholder="abc@gmail.com">
<label>Website</label>
<input type="url" placeholder="https://example.com">
<br>
<input type="checkbox"> I agree to the above information.
<br><br>
<input type="submit" value="Submit"
style="background:#1565C0;color:white;padding:8px 20px;border:none;border-radius:5px;cursor:pointer;">
<input type="reset" value="Reset"
style="background:#757575;color:white;padding:8px 20px;border:none;border-radius:5px;cursor:pointer;">
</fieldset>
</div>
<div class="bottom">
<div>
