<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}
body{
background:#eef5ff;
}
/* Header */
header{
background:linear-gradient(to right,#2563eb,#10b981);
padding:15px;
text-align:center;
color:white;
}
nav a{
color:white;
text-decoration:none;
margin:15px;
font-weight:bold;
}
nav a:hover{
color:rgb(255, 0, 0);
}
/* Hero */
.hero{
height:260px;
background:
linear-gradient(rgba(139, 222, 145, 0.989),rgb(197, 207, 199)),
url("images/pet.jpg");
background-size:cover;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}
.hero div{
background:rgba(255,255,255,.2);
padding:20px;
border-radius:15px;
box-shadow:0 0 10px rgb(39, 16, 16);
}
.hero button{
margin-top:10px;
padding:10px 20px;
background:#2563eb;
color:white;
border:none;
border-radius:20px;
cursor:pointer;
}
.hero button:hover{
background:#10b981;
}
/* Services */
h2{
text-align:center;
margin:25px;
color:#2563eb;
}
.services{
display:flex;
justify-content:space-around;
padding:20px;
}
.card{
width:30%;
background:white;
padding:15px;
text-align:center;
border-radius:15px;
box-shadow:0 0 10px gray;
border:8px solid transparent;
border-image:url("images/border.png") 30 round;
}
.card:hover{
transform:scale(1.03);
}
.card img{
width:100%;
height:150px;
border-radius:10px;
opacity:.8;
}
.card img:hover{
opacity:1;
}
</style>
</head>
