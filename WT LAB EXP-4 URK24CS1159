<style>
/* Login & Sign Up */
.account{
display:flex;
justify-content:center;
gap:25px;
padding:20px;
}
.box{
width:280px;
background:white;
padding:20px;
border-radius:15px;
box-shadow:0 0 10px gray;
}
.box h3{
text-align:center;
margin-bottom:15px;
color:#2563eb;
}
.box input{
width:100%;
padding:10px;
margin:8px 0;
border:2px solid #ccc;
border-radius:8px;
}
.box input:focus{
border:2px solid red;
background:#eef;
outline:none;
}
.box input:required{
border-color:#2563eb;
}
.box input[type=email]:valid{
color:blue;
}
.box input[type=email]:invalid{
color:red;
}
.box button{
width:100%;
padding:10px;
margin-top:10px;
background:linear-gradient(to right,#2563eb,#10b981);
color:white;
border:none;
border-radius:8px;
cursor:pointer;
}
.box button:hover{
opacity:.9;
}
/* Package Table */
table{
width:70%;
margin:30px auto;
border-collapse:collapse;
background:white;
box-shadow:0 0 10px gray;
}
th,td{
padding:10px;
border:1px solid #ddd;
text-align:center;
}
th{
background:#2563eb;
color:white;
}
tr:nth-child(odd){
background:#f5f5f5;
}
tr:nth-child(even){
background:#dff7ff;
}
tr:hover{
background:#fff2a8;
}
/* Footer */
footer{
margin-top:30px;
padding:15px;
text-align:center;
color:white;
background:linear-gradient(to right,#2563eb,#10b981);
}
</style>
<h2>Member Login</h2>
<div class="account">
<div class="box">
<h3>Sign In</h3>
<input type="email" placeholder="Email" required>
<input type="password" placeholder="Password" required>
<button>Sign In</button>
</div>
<div class="box">
