.cards{
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:25px;
}
.card{
width:250px;
background:white;
padding:20px;
border-radius:15px;
box-shadow:0 8px 20px rgba(0,0,0,.15);
text-align:center;
transition:.4s;
}
.card:hover{
transform:translateY(-8px);
}
.card h3{
color:#8B4513;
margin-bottom:10px;
}
@media(max-width:768px){
nav{
flex-direction:column;
}
.about{
flex-direction:column;
}
.about img{
width:100%;
}
.cards{
flex-direction:column;
align-items:center;
